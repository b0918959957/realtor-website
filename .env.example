# 複製本檔案為 .env.local 後填入。.env.local 已被 .gitignore 排除，不會提交到 Git。

# ── 後台密碼（正式上線必填）──────────────────────────
# 保護 /admin/appointments 與管理用 API，避免客戶個資被任何人看到。
#
# 本機開發：不設定時自動放行，方便直接操作。
# 正式環境：未設定會直接停用後台（回傳 503），不會裸奔。
#
# 帳號預設為 admin，可用 ADMIN_USER 自訂。
# 密碼請設定夠長的隨機字串。
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── 正式網址（選用）─────────────────────────────────
# 用於 SEO 與社群分享圖片。部署到 Vercel 會自動帶入，通常不需設定。
NEXT_PUBLIC_SITE_URL=

# ── Slack 通知（選用）────────────────────────────────
# 設定後，每當有客戶送出預約，就會推播到指定的 Slack 頻道。
# 留空或不設定 = 不啟用，預約流程完全不受影響。
#
# 取得方式：https://api.slack.com/apps → Create New App
#   → Incoming Webhooks → 開啟 → Add New Webhook to Workspace
#   → 選擇要接收通知的頻道 → 複製產生的網址
SLACK_WEBHOOK_URL=
